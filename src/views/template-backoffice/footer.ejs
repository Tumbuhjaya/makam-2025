  $('.admin_only').hide()
            $('.pengelola_only').hide()
                        $('.pengesahan').show()
                        $('.sinkronisasi').hide()

            
          }else if (data.user.is_admin == 0 && data.user.kategori_tpu==1) {
            $('.makam_special').show()
            $('.makam_biasa').hide()
          }else{
            $('.makam_special').hide()
            $('.makam_biasa').show()
          }
        })
