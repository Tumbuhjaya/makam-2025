                                    <div class="form-group mb-2">
                                        <label for="">Kecamatan</label>
                                        <select name="" id="kecamatan" class="form-control autocomplete">
                                            <option value="">-- Pilih --</option>
                                            <!-- <% for(var i=0; i<kec.length; i++){ %>
                                                <option value="<%= kec[i].id_kecamatan%>"><%= kec[i].kecamatan%></option>
                                            <%}%> -->
                                        </select>
                                    </div>

                                    <div class="form-group mb-2">
                                        <label for="">Lokasi Pemakaman</label>
                                        <select name="" id="lokasi" class="form-control autocomplete">
