<script type="text/javascript">
  let jumlah_data_per_page = 10
  let hal = 1
  let maxHal = 0
  $('#jumlah_data_per_page').change(function () {
    jumlah_data_per_page = $('#jumlah_data_per_page').val()
    ubah_page(hal)
  })
  async function ubah_page(halaman) {
    if (halaman>0) {
    if (halaman) {
        hal = halaman
      }

      let data = {
        cari : $('#cari').val(),
        mulai : $('#mulai').val(),
                sk_perpanjangan:1,
                                        jns_pemakaman:4,

        akhir : $('#akhir').val(),
        count:1
      }
 let hsl = await $.post('/manajemen_perijinan/perpanjangan/pemakaman_special',data)
    maxHal = Math.ceil( hsl.data[0].jml/jumlah_data_per_page)
    // let previous_disable = ''

    // if (hal - 1 <= 0) {
    //       previous_disable = 'disabled'
    //     }
    $('.pagination').empty()
    for (let i = 0; i < 3; i++) {
            let previous_disable = ''
        if (hal - 1 <= 0) {
          previous_disable = 'disabled'
        }
        let li = `<li class="${hal - 1 <= 0?'disabled':''}" onclick="ubah_page(${hal - 1})">
          <a href="#" >
            Sebelumnya
          </a>
        </li>`
        if (hal>1) {
          li += `<li onclick="ubah_page(${1})">
          <a href="#" >
            1
          </a>
        </li>`
        }
        for (let i = 0; i < 3; i++) {
          if (hal + i <= maxHal) {

            let current = ''
            // let aktif = ''
            // if (i == 0) {
            //   aktif = 'active'
            // }
            li += `
        <li class="${i == 0?'active':''}" onclick="ubah_page(${hal + i})">
          <a href="#">${hal + i} <span class="sr-only">(current)</span></a>
        </li>`
          }

        }
        // let next_disable = ''
        // if (hal + 1 >= maxHal) {
        //   next_disable = 'disabled'
        // }
        $('.pagination').empty()
        $('.pagination').append(`
        <nav aria-label="...">
          <ul class="pagination">
            ${li}
            <li >...</li>
            <li >
              <a href="#" onclick="ubah_page(${maxHal})">
                ${maxHal}
              </a></li>
            <li class="${hal + 1 >= maxHal?'disabled':''}">
              <a href="#" onclick="ubah_page(${hal + 1})">
                Selanjutnya
              </a></li>
          </ul>
        </nav>`)}

      let data2 = {
        cari : $('#cari').val(),
        mulai : $('#mulai').val(),
        akhir : $('#akhir').val(),
        sk_perpanjangan:1,
                        jns_pemakaman:4,

        limit: jumlah_data_per_page,
        offset: (hal - 1) * jumlah_data_per_page,
  }
  $('#list_data').empty()
   await $.post('/manajemen_perijinan/perpanjangan/pemakaman_special',data2).then(function (hsl2) {
    $('#entry').html(`Menampilkan ${((hal - 1) * jumlah_data_per_page) +1} sampai ${((hal - 1) * jumlah_data_per_page) + hsl2.data.length} dari ${(hsl.data[0].jml).toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.')} entri`);
  for (let i = 0; i < hsl2.data.length; i++) {
    let color = ''
    if (hsl2.data[i].tanggal_berlaku_surat) {
      if (hsl2.data[i].kadaluarsa) {
        color = `danger`
      } else {
        color = `success`
      }
    }

    // let a = !hsl2.user.master_makam_id?`<li><button style="margin-right: 0;" class="btn btn-warning btn-embossed btn-sm cetak_sk" onclick="cetak_sk(${hsl2.data[i].perpanjangan_id},${hsl2.data[i].jenazah_id},${hsl2.data[i].dokument_id})" data-jenazah_id="${hsl2.data[i].jenazah_id}" data-dokument_id="${hsl2.data[i].dokument_id}"   data-id="${hsl2.data[i].perpanjangan_id}" data-toggle="modal" data-target=".modal-cetak-sk">Buat Draft SK</button></li>`:``
    // let b = hsl2.data[i].cek=='true' && hsl2.data[i].status_pembayaran == 'Sudah Dibayar' && !hsl2.user.master_makam_id?` <li><a class="btn btn-success btn-embossed btn-sm" target="_blank" href="/manajemen_perijinan/pemakaman/cetak_perpanjangan/${hsl2.data[i].jenazah_id}" role="button">Cetak Draft SK</a></li>`:''
    // let c =   hsl2.data[i].sk_perpanjangan!= null?`<li><a href="/foto/${hsl2.data[i].sk_perpanjangan}" class="btn btn-dark btn-sm btn-embossed" download>Download SK</a></li>`:''
    // let d =  `<li><button class="btn btn-info btn-embossed btn-sm upload_sk" role="button" style="margin-right: 0;" data-perpanjangan_id="${hsl2.data[i].perpanjangan_id}" data-toggle="modal"  data-target="#exampleModal">Upload SK</button></li>`
    // let e = `<li><a class="btn btn-danger btn-embossed btn-sm" target="_blank" href="/manajemen_master/data_jenazah/edit/${hsl2.data[i].jenazah_id}/4" role="button" >Edit Jenazah</a></li>`
    // let f1 = hsl2.data[i].foto_ktp_pemohon?`<li><a href="/foto/${hsl2.data[i].foto_ktp_pemohon}" target="_blank">KTP Ahli Waris</a></li>`:''
    // let f2 = hsl2.data[i].foto_ktp_jenazah?`<li><a href="/foto/${hsl2.data[i].foto_ktp_jenazah}" target="_blank">KTP Jenazah</a></li>`:''
    // let f3 = hsl2.data[i].surat_kematian?`<li><a href="/foto/${hsl2.data[i].surat_kematian}" target="_blank">Surat Kematian Rumah Sakit/RW/RT</a></li>`:''
    // let f4 = hsl2.data[i].surat_lurah?`<li><a href="/foto/${hsl2.data[i].surat_lurah}" target="_blank">Surat Dari Lurah / Catatan Sipil</a></li>`:''
    // let f5 = hsl2.data[i].sk_lama?`<li><a href="/foto/${hsl2.data[i].sk_lama}" target="_blank">SK Lama / Surat Pernyataan</a></li>`:''
    // let f = `   
    //   <li>
    //   <div class="dropup">
    //                       <button class="btn btn-primary btn-sm btn-embossed dropdown-toggle" style="margin:0;" type="button" id="dropdownMenu2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    //                         Persyaratan
    //                         <span class="caret"></span>
    //                       </button>
    //                       <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenu2">
    //                         ${f1}${f2}${f3}${f4}${f5}
    //                       </ul>
    //                     </div></li>`

    let a = hsl2.data[i].cek=='true' && hsl2.user.is_admin!=0?`<li><button class="btn btn-success btn-embossed btn-sm" role="button"  onclick="ubah_status('${hsl2.data[i].perpanjangan_id}',2,'${hsl2.data[i].sk_perpanjangan}')"  data-toggle="modal" data-target=".modalTte" style="margin-right:0;">Disetujui</button></li>`:''
    let b = hsl2.data[i].cek=='true' && hsl2.user.is_admin!=0?`<li><button class="btn btn-danger btn-embossed btn-sm" role="button"  onclick="ubah_status('${hsl2.data[i].perpanjangan_id}',1)"  style="margin-right:0;">Dibatalkan</button></li>`:''
    let c = hsl2.data[i].cek=='true' && hsl2.user.is_admin!=0?`<li><button class="btn btn-info btn-embossed btn-sm" role="button" onclick="ubah_id('${hsl2.data[i].perpanjangan_id}')"  data-toggle="modal" data-target=".modalInfo" style="margin-right:0;">Info</button></li>`:''
    let d = hsl2.data[i].cek=='true' && hsl2.user.is_admin!=0?`<li><a class="btn btn-dark btn-embossed btn-sm" target="_blank"  onclick="cetak('${hsl2.data[i].sk_perpanjangan}')"  role="button" style="margin-right:0;">Download SK</a></li>`:''
    console.log(hsl2.data[i]);
      $('#list_data').append(`<tr>
                <td>${((hal - 1) * jumlah_data_per_page)+ i +1}</td>
                 <td>
                  <center>
                    <ul class="list-inline" style="text-align: center;margin-bottom:5px">
                      ${hsl2.data[i].status_tte == 0 ?a+b:''}
                
                       ${c}
                    </ul>

                    <ul class="list-inline" style="text-align: center;">
                      
                                           ${hsl2.data[i].status_tte == 2?d:''}

                    </ul>
                    </center>
                </td>
                ${ hsl2.data[i].status_tte == 0 ?'<td class="list-inline-item"><span class="badge badge-dark">Belum disetujui</span></td>':
                 hsl2.data[i].status_tte == 2 ? '<td class="list-inline-item"><span class="badge badge-success">Disetujui</span></td>':'<td class="list-inline-item"><span class="badge badge-danger">Dibatalkan</span></td>'
}
                <td>${ hsl2.data[i].inserted_perpanjangan}</td>
                <td>${ hsl2.data[i].nama_ahli_waris}</td>
                <td>${ hsl2.data[i].nama_jenazah}</td>
                <td>${ hsl2.data[i].tanggal_meninggal}</td>
                <td>${ hsl2.data[i].tanggal_dimakamkan}</td>
                <td>${ hsl2.data[i].kecamatan}</td>
                <td>${ hsl2.data[i].nama_tpu}</td>
                <td>${ hsl2.data[i].blok}</td>
                <td>${ hsl2.data[i].sub_blok}</td>
                <td>${ hsl2.data[i].no_liang}</td>
                <td>${ hsl2.data[i].kode_billing}</td>
                <td>${ hsl2.data[i].status_pembayaran}</td>
                <td>
                  <span class="label label-${color}">${ hsl2.data[i].tanggal_berlaku_surat}</span>
                </td>
               
              </tr>`)      
    }
  
  })
}
  }
ubah_page(1)
function cari() {
  hal = 1
  ubah_page(1)
}
function reset() {
  $('#cari').val('')
  ubah_page(1)

}

