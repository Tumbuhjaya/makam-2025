<% include ../../template-backoffice/header.ejs %>

<!-- BEGIN PAGE CONTENT -->
<div class="page-content">
  <div class="header">
    <h2><strong>Data Permohonan Ijin Pemakaman Jenazah</strong></h2>
    <div class="breadcrumb-wrapper">
      <ol class="breadcrumb">
        <li><a href="/backoffice">Dashboard</a>
        </li>
        <li class="active">Data</li>
      </ol>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <div class="panel">
        <div class="panel-header header-line">
          <div class="alert alert-danger" role="alert">
            <h6><strong>Pencarian berdasarkan status permohonan</strong></h6>
            <div class="row">
              <div class="col-md-12 col-lg-12">
                <select name="" id="verifikasi" class="form-control">
                  <option value="" >-- Pilih --</option>
                    <option value="0" <%= status === '0' ? 'selected':''%>>Belum Diverifikasi</option>
                    <option value="1" <%= status === '1' ? 'selected':''%>>Revisi</option>
                    <option value="4" <%= status === '4' ? 'selected':''%>>Di Revisi oleh User </option>
                    <!-- <option value="3" <%= status == 3 ? 'selected':''%>>Dibatalkan</option> -->
                </select>

                <button class="btn btn-primary btn-embossed" onclick="cari()" style="margin-top: 15px;">Cari</button>
              </div>
            </div>
          </div>

           <a class="btn btn-primary btn-embossed" href="/manajemen_pemakaman_special/pemakaman/insert" role="button"><i class="fa fa-plus" aria-hidden="true"></i>Tambah Data</a>
              <!-- <button class="btn btn-primary btn-block" data-toggle="modal" data-target="#exampleModal" >Daftar Permohonan</button> -->
          </div>
        <div class="panel-content pagination2 table-responsive">
          <table class="table table-bordered table-striped table-hover" id="data">
            <thead>
              <tr>
                <th class="header" rowspan="2">No.</th>
                            <th class="header" rowspan="2" style="min-width: 260px;">Option</th>
                      <th class="header" rowspan="2" style="min-width: 150px;">Status TTE</th>
                <th class="header" rowspan="2">Tanggal Permohonan</th>
                <!-- <th class="header" rowspan="2" style="min-width: 100px;">Kode Registrasi</th> -->
                <th class="header" rowspan="2" style="min-width: 150px;">Nama Pemohon/Ahli Waris</th>
                <th class="header" rowspan="2" style="min-width: 150px;">Nama Jenazah</th>
                <th class="header" colspan="2" style="text-align: center;">Tanggal</th>
                <!-- <th class="header" rowspan="2" style="text-align: center;">Tanggal Dimakamkan</th> -->
                <th class="header" colspan="4" style="text-align: center;">Lokasi Pemakaman</th>
                <th class="header" colspan="3" style="text-align: center;">Retribusi & Pembayaran</th>
                <th class="header" rowspan="2" style="min-width: 100px;">Status Permohonan</th>

                <!-- <th class="header" rowspan="2" style="min-width: 100px;">Option</th> -->
              </tr>

              <tr>
                <th class="header" style="min-width: 120px;">Meninggal</th>
                <th class="header" style="min-width: 120px;">Dimakamkan</th>
                <th class="header" style="min-width: 100px;">Kecamatan</th>
                <th class="header" style="min-width: 50px;">Lokasi</th>
                <th class="header" style="min-width: 50px;">Blok</th>
                <th class="header" style="min-width: 50px;">Sub Blok</th>
                <th class="header" style="min-width: 100px;">Retribusi</th>
                <th class="header" style="min-width: 100px;">Kode Billing</th>
                <th class="header" style="min-width: 100px;">Status</th>
              </tr>
            </thead>
            
      <tbody>
  <% for(let i = 0; i < data.length; i++) { %>
    <tr>
      <td><%= i + 1 %></td>
      
      <td>
        <center>
          <ul class="list-inline" style="text-align: center; margin-bottom:5px">
            <% if(data[i].status_tte == 0){%>
              <li><button class="btn btn-success btn-embossed btn-sm" role="button"  onclick="ubah_status('<%=data[i].dokument_id%>',2,'<%=data[i].sk%>')"  data-toggle="modal" data-target=".modalTte" style="margin-right:0;">Disetujui</button></li>
              <li><button class="btn btn-danger btn-embossed btn-sm" role="button"  onclick="ubah_status('<%=data[i].dokument_id%>',1)"  style="margin-right:0;">Dibatalkan</button></li>
              <%}%>
              <li><button class="btn btn-info btn-embossed btn-sm" role="button" onclick="ubah_id('<%=data[i].dokument_id%>')"  data-toggle="modal" data-target=".modalInfo" style="margin-right:0;">Info</button></li>
                          <% if(data[i].status_tte == 2){%>
                            <li><a class="btn btn-dark btn-embossed btn-sm" target="_blank"  onclick="cetak('<%=data[i].sk%>')"  role="button" style="margin-right:0;">Download SK</a></li>
              <%}%>

          </ul>

          <ul class="list-inline" style="text-align: center;">
            <% if (data[i].cek == 'true' && user.is_admin == 1 && data[i].status_tte == 2) { %>
              <li>
                <a class="btn btn-dark btn-embossed btn-sm" target="_blank" onclick="cetak('<%= data[i].sk %>')" role="button" style="margin-right:0;">Download SK</a>
              </li>
            <% } %>
          </ul>
        </center>
      </td>

      <td>
        <% if (data[i].status_tte == 0) { %>
          <span class="badge badge-dark">Belum disetujui</span>
        <% } else if (data[i].status_tte == 2) { %>
          <span class="badge badge-success">Disetujui</span>
        <% } else { %>
          <span class="badge badge-danger">Dibatalkan</span>
        <% } %>
      </td>

      <td><%= data[i].inserted %></td>
      <td><%= data[i].nama_ahli_waris %></td>
      <td><%= data[i].nama_jenazah %></td>
      <td><%= data[i].tanggal_meninggal %></td>
      <td><%= data[i].tanggal_dimakamkan %></td>
      <td><%= data[i].kecamatan_tpu %></td>
      <td><%= data[i].nama_tpu %></td>
      <td><%= data[i].blok %></td>
      <td><%= data[i].sub_blok %></td>
      <td><%= data[i].retribusi %></td>
      <td><%= data[i].kode_billing %></td>
      <td><%= data[i].status_pembayaran %></td>
      <td><%= (data[i].status_permohonan == null) ? 'Revisi' : data[i].status_permohonan %></td>
    </tr>
  <% } %>
</tbody>
          </table>
        </div>
      </div>
    </div>  
  </div>
  <% include ../../template-backoffice/copyright.ejs %>
</div>
<!-- END PAGE CONTENT -->
<div class="modal fade modalTte" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form action="#" method="post"   enctype="application/x-www-form-urlencoded" class="form-horizontal">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title" id="myModalLabel">Login Esign BSrE</h4>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label for="" class="col-sm-3 control-label">NIK</label>
            <div class="col-sm-9">
                <input type="" class="form-control" id="nik" aria-describedby="" autocomplete="off" required>
            </div>
          </div>

          <div class="form-group">
            <label for="" class="col-sm-3 control-label">Passpharse</label>
            <div class="col-sm-9">
                <input type="text" class="form-control" id="passpharse" aria-describedby="" autocomplete="off" required>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <!-- <button type="button" class="btn btn-default" data-dismiss="modal">Close</button> -->
          <button type="button" class="btn btn-primary" onclick="cetak_2()">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% include ../../template-backoffice/footer.ejs %>

