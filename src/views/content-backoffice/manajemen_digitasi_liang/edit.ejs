<script type="text/javascript">
    $('#jenazah_id').change(async function () {
        if ($('#jenazah_id').val()=='') {
            $('.text_nama_jenazah').show()
        }else{
            $('.text_nama_jenazah').hide()
        }
    })
    let jumlah_data_per_page = 10
    let hal = 1
    let maxHal = 0
    $('#jumlah_data_per_page').change(function () {
      jumlah_data_per_page = $('#jumlah_data_per_page').val()
      ubah_page(hal)
    })
    async function ubah_page(halaman) {
      if (halaman>0) {
      if (halaman) {
          hal = halaman
        }
  
        let data = {
        //   cari : $('#cari').val(),
                    no_liang : $('#cari').val(),

          count:1,
          makam_id:'<%=nama_makam%>'
        }
   let hsl = await $.post('/manajemen_master/digitasi_liang',data)
      maxHal = Math.ceil( hsl.data[0].jml/jumlah_data_per_page)
      $('.pagination').empty()
      for (let i = 0; i < 3; i++) {
              let previous_disable = ''
          if (hal - 1 <= 0) {
            previous_disable = 'disabled'
          }
          let li = `<li class="${hal - 1 <= 0?'disabled':''}" onclick="ubah_page(${hal - 1})">
            <a href="#" >
              Sebelumnya
            </a>
          </li>`
          if (hal>1) {
            li += `<li onclick="ubah_page(${1})">
            <a href="#" >
              1
            </a>
          </li>`
          }
          for (let i = 0; i < 3; i++) {
            if (hal + i <= maxHal) {
  
              let current = ''
              li += `
          <li class="${i == 0?'active':''}" onclick="ubah_page(${hal + i})">
            <a href="#">${hal + i} <span class="sr-only">(current)</span></a>
          </li>`
            }
  
          }
          $('.pagination').empty()
          $('.pagination').append(`
          <nav aria-label="...">
            <ul class="pagination">
              ${li}
              <li >...</li>
              <li >
                <a href="#" onclick="ubah_page(${maxHal})">
                  ${maxHal}
                </a></li>
              <li class="${hal + 1 >= maxHal?'disabled':''}">
                <a href="#" onclick="ubah_page(${hal + 1})">
                  Selanjutnya
                </a></li>
            </ul>
          </nav>`)}
  
        let data2 = {
        //   cari : $('#cari').val(),
                            no_liang : $('#cari').val(),

          limit: jumlah_data_per_page,
          offset: (hal - 1) * jumlah_data_per_page,
          makam_id:'<%=nama_makam%>'

    }
    $('#list_data').empty()
     await $.post('/manajemen_master/digitasi_liang',data2).then(function (hsl2) {
        console.log(hsl2.data.length);
        cari(hsl2.data[0].x,hsl2.data[0].y)
      $('#entry').html(`Menampilkan ${((hal - 1) * jumlah_data_per_page) +1} sampai ${((hal - 1) * jumlah_data_per_page) + hsl2.data.length} dari ${(hsl.data[0].jml).toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.')} entri`);
    for (let i = 0; i < hsl2.data.length; i++) {

  
        $('#list_data').append(`<tr>
                  <td>${((hal - 1) * jumlah_data_per_page)+ i +1}</td>
                  <td>${ hsl2.data[i].blok}</td>
                  <td>${ hsl2.data[i].sub_blok}</td>
                  <td>${ hsl2.data[i].no_liang}</td>
                  <td>${ hsl2.data[i].keterangan_pengelola||''}</td>
                  <td>
                    <center>
                      <ul class="list-inline" style="text-align: center;">
                        <li><button class="btn btn-info btn-embossed btn-sm" role="button" style="margin-right: 0;" onclick="ganti_id(${ hsl2.data[i].id})"   data-toggle="modal"  data-target="#exampleModal">Keterangan Liang</button></li>
                        ${hsl2.data[i].jml_jenazah==0?`<li><a class="btn btn-danger btn-embossed btn-sm" href="/manajemen_master/digitasi_liang/hapus/${hsl2.data[i].id}/<%= nama_makam%>" role="button" onclick="return confirm('Apakah anda yakin untuk menghapus data ini ?');"><i class="fa fa-trash-o" aria-hidden="true"></i></a></li>`:''}
                      </ul>
                      </center>
                  </td>
                </tr>`)      
      }
    
    })
    }
  
  }
  
  ubah_page(1)
  function pencarian() {
    hal = 1
    ubah_page(1)
  }
  function reset() {
    $('#cari').val('')
    ubah_page(1)
  
  }
  function ganti_id(id) {
    $('#id').val(id)
  }
</script>
<script type="text/javascript">
        function toWKT(layer) {
            var lng, lat, coords = [];
            if (layer instanceof L.Polygon || layer instanceof L.Polyline) {
                var latlngs = layer.getLatLngs();
                for (var i = 0; i < latlngs.length; i++) {
                    var latlngs1 = latlngs[i];
                    if (latlngs1.length) {
                        for (var j = 0; j < latlngs1.length; j++) {
                            coords.push(latlngs1[j].lng + " " + latlngs1[j].lat);
                            if (j === 0) {
                                lng = latlngs1[j].lng;
                                lat = latlngs1[j].lat;
                            }
                        }
                    } else {
                        coords.push(latlngs[i].lng + " " + latlngs[i].lat);
                        if (i === 0) {
                            lng = latlngs[i].lng;
                            lat = latlngs[i].lat;
                        }
                    }
                };
                if (layer instanceof L.Polygon) {
                    return "POLYGON((" + coords.join(",") + "," + lng + " " + lat + "))";
                } else if (layer instanceof L.Polyline) {
                    return "LINESTRING(" + coords.join(",") + ")";
                }
            } else if (layer instanceof L.Marker) {
                return "POINT(" + layer.getLatLng().lng + " " + layer.getLatLng().lat + ")";
            }
        };
