      $.get(`/permohonan_ijin/subblokByBlok?blok=${$(this).val()}&agama=${$().val('#agama_makam').val()}&nama_tpu=${$('#lokasi_makam').val()}`, function (data) {   
        data.data.sort((a,b)=>a.subblok.substring(1,a.subblok.length)-b.subblok.substring(1,b.subblok.length))
        $(`#subblok_makam`).append(`<option value="">-- Pilih --</option>`)
        for (let i = 0; i < data.data.length; i++) {
            $(`#subblok_makam`).append(`<option value="${data.data[i].subblok}">${data.data[i].subblok}</option>`)
        }
      })
    })
