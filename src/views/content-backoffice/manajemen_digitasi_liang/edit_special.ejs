      $.get(`/permohonan_ijin/getBlokByAgama?agama=${$(this).val()}&master_makam_id=${$('#lokasi_makam').val()}`, function (data) {  
          $(`#blok_makam`).append(`<option value="">-- Pilih --</option>`)

          for (let i = 0; i < data.length; i++) {
              console.log(data[i].blok);

