    // Fungsi untuk merender pagination
    function renderPagination(data, paginationId, type) {
      const paginationContainer = document.getElementById(paginationId);
      const { currentPage, totalPages, limit } = data;

      let paginationHtml = `<ul class="pagination">`;

      // Tombol "First" dan "Prev"
      if (currentPage > 1) {
        paginationHtml += `<li><a href="#" data-page="1" data-type="${type}" class="page-link">First</a></li>`;
        paginationHtml += `<li><a href="#" data-page="${currentPage - 1}" data-type="${type}" class="page-link">Prev</a></li>`;
      }

      // Halaman 1 sebelum current
      if (currentPage > 1) {
        paginationHtml += `<li><a href="#" data-page="${currentPage - 1}" data-type="${type}" class="page-link">${currentPage - 1}</a></li>`;
      }

      // Halaman saat ini
      paginationHtml += `<li class="active"><a href="#">${currentPage}</a></li>`;

      // Halaman 1 setelah current
      if (currentPage < totalPages) {
        paginationHtml += `<li><a href="#" data-page="${currentPage + 1}" data-type="${type}" class="page-link">${currentPage + 1}</a></li>`;
      }

      // Tombol "Next" dan "Last"
      if (currentPage < totalPages) {
        paginationHtml += `<li><a href="#" data-page="${currentPage + 1}" data-type="${type}" class="page-link">Next</a></li>`;
        paginationHtml += `<li><a href="#" data-page="${totalPages}" data-type="${type}" class="page-link">Last</a></li>`;
      }

      paginationHtml += `</ul>`;
      paginationContainer.innerHTML = paginationHtml;
    }

    // Event listener untuk klik pada tombol pagination
    document.body.addEventListener("click", (e) => {
      if (e.target.classList.contains("page-link")) {
        e.preventDefault();
        const page = e.target.dataset.page;
        const type = e.target.dataset.type;

        if (type === "permohonan") {
          loadContent(
            `/api/permohonan?page=${page}&limit=10`,
            "permohonan-container",
            "pagination-permohonan",
            "permohonan",
          );
        } else if (type === "perpanjangan") {
          loadContent(
            `/api/perpanjangan?page=${page}&limit=10`,
            "perpanjangan-container",
            "pagination-perpanjangan",
            "perpanjangan",
          );
        }
      }
    });

    // Muat data default saat halaman pertama kali dimuat
    loadContent(
      "/api/permohonan?page=1&limit=10",
      "permohonan-container",
      "pagination-permohonan",
      "permohonan",
    );
    loadContent(
      "/api/perpanjangan?page=1&limit=10",
      "perpanjangan-container",
      "pagination-perpanjangan",
      "perpanjangan",
    );
  });
  let data_jenazah = {}
  let is_loading = false; // Flag untuk mencegah trigger onchange otomatis

async function set_jenazah(params) {
    const data = JSON.parse(params);
    data_jenazah = data;
    
    is_loading = true; // KUNCI: Tandai bahwa kita sedang mengisi data awal

    // Reset Dropdown
    $("#makam_id, #sub_blok, #blok, #agama").html('<option value="">-- Pilih --</option>').val(null).trigger('change');

    const basePost = { tpu: data.tpu, jns_pemakaman: data.jns_pemakaman };

    try {
        // Fetch data secara paralel
        console.log({ ...basePost, blok: data.makam_id ? data.blok : data.pilihan_blok, sub_blok: data.makam_id ? data.sub_blok : data.pilihan_sub_blok });
        
        const [resNoLiang, resSubBlok, resBlok, resAgama] = await Promise.all([
            $.post("/makam/list_makam", { ...basePost, blok: data.makam_id ? data.blok : data.pilihan_blok, sub_blok: data.makam_id ? data.sub_blok : data.pilihan_sub_blok }),
            $.post("/makam/list_makam", { ...basePost, blok: data.makam_id ? data.blok : data.pilihan_blok, kolom: "sub_blok" }),
            $.post("/makam/list_makam", { ...basePost, kolom: "blok" }),
            $.post("/makam/list_makam", { kolom: "agama" })
        ]);

        // Eksekusi Pengisian Data
        populateSelect("makam_id", resNoLiang.data, "id", data.makam_id);
        populateSelect("sub_blok", resSubBlok.data, "sub_blok", data.makam_id ? data.sub_blok : data.pilihan_sub_blok);
        populateSelect("blok", resBlok.data, "blok", data.makam_id ? data.blok : data.pilihan_blok);
        
        // Ambil agama pertama jika ada
        const agamaVal = resAgama.data.length > 0 ? resAgama.data[0].agama : null;
        populateSelect("agama", resAgama.data, "agama", agamaVal);

    } catch (error) {
        console.error("Gagal memuat data:", error);
    } finally {
        is_loading = false; // BUKA KUNCI: Sekarang user bisa berinteraksi normal
    }
}

// 1. Saat BLOK berubah
$('#blok').on('change', async function() {
    if (is_loading) return; // JANGAN jalankan jika sedang set_jenazah
    
    const blokVal = $(this).val();
    if (!blokVal) return;

    $("#sub_blok, #makam_id").html('<option value="">-- Pilih --</option>').trigger('change');

    try {
        const res = await $.post("/makam/list_makam", { 
            tpu: data_jenazah.tpu, 
            jns_pemakaman: data_jenazah.jns_pemakaman, 
            blok: blokVal, 
            kolom: "sub_blok" 
        });
        populateSelect("sub_blok", res.data, "sub_blok", null);
    } catch (e) {
        console.error("Gagal update Sub Blok:", e);
    }
});

// 2. Saat SUB BLOK berubah
$('#sub_blok').on('change', async function() {
    if (is_loading) return; // JANGAN jalankan jika sedang set_jenazah
    
    const subBlokVal = $(this).val();
    const blokVal = $('#blok').val();
    if (!subBlokVal) return;

    $("#makam_id").html('<option value="">-- Pilih --</option>').trigger('change');

    try {
        const res = await $.post("/makam/list_makam", { 
            tpu: data_jenazah.tpu, 
            jns_pemakaman: data_jenazah.jns_pemakaman, 
            blok: blokVal, 
            sub_blok: subBlokVal 
        });
        populateSelect("makam_id", res.data, "id", null);
    } catch (e) {
        console.error("Gagal update No Liang:", e);
    }
});
