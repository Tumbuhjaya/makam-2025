function populateSelect(elementId, listData, dataKey, selectedValue) {
    const $el = $(`#${elementId}`);
    let options = '<option value="">-- Pilih --</option>';
    
    if (listData && listData.length > 0) {
        listData.forEach(item => {
            const val = item[dataKey];
            const text = (dataKey === 'id') ? item.no_liang : val;
            const selected = (val == selectedValue) ? 'selected' : '';
            options += `<option value="${val}" ${selected}>${text}</option>`;
        });
    }
    $el.html(options).trigger('change');
}
  $("#status").change(function () {
    if ($(this).val() == "") {
      $(".konten-revisi").hide();
    }

    if ($(this).val() == "0") {
      $(".konten-revisi").hide();
    }

    if ($(this).val() == "1") {
      $(".konten-revisi").show();
    }

    if ($(this).val() == "2") {
      $(".konten-revisi").hide();
    }

    if ($(this).val() == "3") {
