<script type="text/javascript">
      $('.konten-dalam-pemohon').hide(); 
      $('.konten-luar-pemohon').hide(); 
      let domisili_pemohon = $(`#domisili_pemohon`).val()
      $('.konten-dalam-pemohon').hide(); 
      $('.konten-luar-pemohon').hide(); 
            if (domisili_pemohon == '') { 
                $('.konten-dalam-pemohon').hide(); 
                $('.konten-luar-pemohon').hide(); 
            } 
    
            if (domisili_pemohon == '0') { 
                $('.konten-dalam-pemohon').show(); 
                $('.konten-luar-pemohon').hide(); 
            }  
    
            if (domisili_pemohon == '1') { 
                $('.konten-dalam-pemohon').hide(); 
                $('.konten-luar-pemohon').show();    
            } 
            let kecPemohon = $(`#kecamatan_pemohon`).val()
            let kelPemohon = $(`#kelurahan_pemohon`).val()
            let kecJenazah = $(`#kecamatan_jenazah`).val()
            let kelJenazah = $(`#kelurahan_jenazah`).val()
            console.log(kecPemohon,kelPemohon,kecJenazah,kelJenazah);

            $.get(`/permohonan_ijin/kelurahanByKec/${kecPemohon}`,function (data) {
                $(`#kelurahan_pemohon`).empty()
                $(`#kelurahan_pemohon`).append(`<option value="">-- Pilih --</option>`)
                for (let i = 0; i < data.length; i++) {
                    $(`#kelurahan_pemohon`).append(`<option value="${data[i].id_kelurahan}">${data[i].desa}</option>`)
                }
            })
            $.get(`/permohonan_ijin/kelurahanByKec/${kecJenazah}`,function (data) {
                $(`#kelurahan_jenazah`).empty()
                $(`#kelurahan_jenazah`).append(`<option value="">-- Pilih --</option>`)
                for (let i = 0; i < data.length; i++) {
                    $(`#kelurahan_jenazah`).append(`<option value="${data[i].id_kelurahan}">${data[i].desa}</option>`)
                }
            })
      $('#kecamatan_pemohon').change(function () {
        let kecPemohon = $(this).val()

        $.get(`/permohonan_ijin/kelurahanByKec/${kecPemohon}`,function (data) {
                $(`#kelurahan_pemohon`).empty()
                $(`#kelurahan_pemohon`).append(`<option value="" selected>-- Pilih --</option>`)
                for (let i = 0; i < data.length; i++) {
                    $(`#kelurahan_pemohon`).append(`<option value="${data[i].id_kelurahan}">${data[i].desa}</option>`)
                }
            })
      })
      $('#kecamatan_jenazah').change(function () {

      let kecJenazah = $(this).val()
      $.get(`/permohonan_ijin/kelurahanByKec/${kecJenazah}`,function (data) {
          $(`#kelurahan_jenazah`).empty()
          $(`#kelurahan_jenazah`).append(`<option value="" selected>-- Pilih --</option>`)
          for (let i = 0; i < data.length; i++) {
              $(`#kelurahan_jenazah`).append(`<option value="${data[i].id_kelurahan}">${data[i].desa}</option>`)
          }
        })
      })
      $('#domisili_pemohon').change(function(){ 
        console.log($(this).val());
            if ($(this).val() == '') { 
                $('.konten-dalam-pemohon').hide(); 
                $('.konten-luar-pemohon').hide(); 
            } 
    
            if ($(this).val() == '0') { 
                $('.konten-dalam-pemohon').show(); 
                $('.konten-luar-pemohon').hide(); 
            }  
    
            if ($(this).val() == '1') { 
                $('.konten-dalam-pemohon').hide(); 
                $('.konten-luar-pemohon').show();    
            } 
        }
      );
      
      $('.konten-dalam-jenazah').hide(); 
      $('.konten-luar-jenazah').hide(); 
      let domisili_jenazah= $(`#domisili_jenazah`).val()
      
      $('.konten-dalam-jenazah').hide(); 
      $('.konten-luar-jenazah').hide(); 
            if (domisili_jenazah == '') { 
                $('.konten-dalam-jenazah').hide(); 
                $('.konten-luar-jenazah').hide(); 
            } 
    
            if (domisili_jenazah == '0') { 
                $('.konten-dalam-jenazah').show(); 
                $('.konten-luar-jenazah').hide(); 
            }  
    
            if (domisili_jenazah == '1') { 
                $('.konten-dalam-jenazah').hide(); 
                $('.konten-luar-jenazah').show();    
            } 
      $('#domisili_jenazah').change(function(){ 
            if ($(this).val() == '') { 
                $('.konten-dalam-jenazah').hide(); 
                $('.konten-luar-jenazah').hide(); 
            } 
    
            if ($(this).val() == '0') { 
                $('.konten-dalam-jenazah').show(); 
                $('.konten-luar-jenazah').hide(); 
            }  
    
            if ($(this).val() == '1') { 
                $('.konten-dalam-jenazah').hide(); 
                $('.konten-luar-jenazah').show();    
            } 
        }
      );
      // $('.konten-setuju').hide();

      let verifikasi = $(`#verifikasi`).val()
      if(verifikasi==1){
        $('.konten-revisi').show();
      }else{
        $('.konten-revisi').hide();
      }
      // if(verifikasi==2){
      //   $('.konten-setuju').show();
      // }else{
      //   $('.konten-setuju').hide();
      // }
      $('#verifikasi').change(function(){ 
            if ($(this).val() == '') { 
                $('.konten-revisi').hide(); 
                // $('.konten-setuju').hide();
            } 
    
            if ($(this).val() == '0') { 
                $('.konten-revisi').hide(); 
                // $('.konten-setuju').hide();

            }  
    
            if ($(this).val() == '1') { 
              $('.konten-revisi').show();   
              // $('.konten-setuju').hide(); 
            }
            
            if ($(this).val() == '2') { 
              $('.konten-revisi').hide();    
              // $('.konten-setuju').show();
            }
            if ($(this).val() == '3') { 
              $('.konten-revisi').hide();    
              // $('.konten-setuju').hide();
            }
        }
      );
    $( "#kecamatan" ).change(function() {
            var x = $( this ).val();
            $(`#lokasi`).empty()
            $(`#blok`).empty()
            $(`#subblok`).empty()
            $(`#no_liang`).empty()
            $( ".kecamatan_modal" ).val(x)
        
                $.get(`/permohonan_ijin/kecById/${x}`,function (data) {
                    $(`#kecamatan_modal_2`).val(data[0].kecamatan)
                }).then(()=>{
                    $.get(`/permohonan_bergota/lokasiByKec?kec=${x}`,function (data) {
                    $(`#lokasi`).empty()
                    $(`#blok`).empty()
                    $(`#subblok`).empty()
                    $(`#no_liang`).empty()
                    $(`#lokasi`).append(`<option value="">-- Pilih --</option>`)
                    for (let i = 0; i < data.length; i++) {
                                $(`#lokasi`).append(`<option value="${data[i].master_makam_id}" x="${data[i].x}" y="${data[i].y}">${data[i].nama_tpu}</option>`)
                            
                        }
                    })
                })
        })

        $( "#lokasi" ).change(async function() {
            var x = $( this ).val();
            await $.get(`/permohonan_ijin/getNamaLokasi/${x}`,function (data) {
            $(`.lokasi_modal`).val(data.data[0].nama_tpu)
            $(`#blok`).empty()
            $(`#subblok`).empty()
            $(`#no_liang`).empty()
            let h=$( "#jns_permohonan" ).val()
            })
            // cari($('option:selected', this).attr('x'), $('option:selected', this).attr('y'), 17);
             let makamm = $('#lokasi').val();
            console.log();
            $.get(`/permohonan_ijin/getBlokByAgama?master_makam_id=${makamm}`, function (data) {  
                $(`#blok`).append(`<option value="">-- Pilih --</option>`)

                for (let i = 0; i < data.length; i++) {
