<% include ../../template-backoffice/header.ejs %>

<!-- BEGIN PAGE CONTENT -->
<div class="page-content">
  <div class="header">
    <h2><strong>Tambah Data User</strong></h2>
    <div class="breadcrumb-wrapper">
      <ol class="breadcrumb">
        <li><a href="/backoffice">Dashboard</a></li>
        <li><a href="/user">Data User</a></li>
        <li class="active">Tambah Data</li>
      </ol>
    </div>
  </div>
  <div class="row">
    <div class="col-md-12">
      <div class="panel">
        <div class="panel-header header-line">
          <!-- Notifikasi -->
        </div>
        <div class="panel-content">
          <div class="row">
            <div class="col-md-12">

              <!-- Start form -->
              <form role="form" action="/user/submit_insert" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                  <label>Otoritas</label>
                  <div class="row">
                    <div class="col-md-6">
                      <select name="is_admin" id="otoritas" class="form-control">
                        <option value="">-- Pilih --</option>
                        <option value="1">Superadmin</option>
                        <option value="3">Kepala Dinas</option>
                        <option value="2">Kepala UPTD</option>
                        <option value="0">Pengelola TPU</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="form-group konten-tpu">
                  <label>TPU</label>
                  <div class="row">
                    <div class="col-md-6">
                      <select name="master_makam_id" id="" class="form-control" data-search="true">
                        <option value="">-- Pilih --</option>
                        <%for(let i = 0 ;i<tpu.length ; i++){%>
                          <option value="<%= tpu[i].id%>"><%= tpu[i].nama_tpu%></option>
                        <%}%>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <div class="row">
                    <div class="col-sm-12">
                      <hr style="margin-top: 5px;margin-bottom: 5px;">
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label>Username</label>
                  <div class="row">
                    <div class="col-md-6">
                      <input type="text" class="form-control" id="" name="username" >
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label>Password</label>
                  <div class="row">
                    <div class="col-md-6">
                      <input type="password" class="form-control" id="" name="pwd" >
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label>Nama Lengkap</label>
                  <div class="row">
                    <div class="col-md-6">
                      <input type="text" class="form-control" id="" name="fullname" >
                    </div>
                  </div>
                </div>

                <div class="form-group konten-kadis-uptd">
                  <label>NIK</label>
                  <div class="row">
                    <div class="col-md-6">
                      <input type="text" class="form-control" id="NIK" name="NIK" >
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label>NIP</label>
                  <div class="row">
                    <div class="col-md-6">
                      <input type="text" class="form-control" id="" name="NIP" >
                    </div>
                  </div>
                </div>

                <div class="form-group konten-kadis-uptd">
                  <label>Jabatan</label>
                  <div class="row">
                    <div class="col-md-6">
                      <input type="text" class="form-control" id="" name="jabatan" >
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label>Email</label>
                  <div class="row">
                    <div class="col-md-6">
                      <input type="text" class="form-control" id="" name="email" >
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label>Telepon</label>
                  <div class="row">
                    <div class="col-md-6"><input type="text" class="form-control" id="" name="telp" ></div>
                  </div>
                </div>

                <button type="submit" class="btn btn-primary btn-embossed">Simpan</button>
              </form>
              <!-- End form -->
              
            </div>
          </div>
        </div>
      </div>
    </div>  
  </div>
  <% include ../../template-backoffice/copyright.ejs %>
</div>
<!-- END PAGE CONTENT -->

<% include ../../template-backoffice/footer.ejs %>

<script>
  $('.konten-tpu').hide(); 
  $('.konten-kadis-uptd').hide(); 
          $('#otoritas').change(function(){ 
            console.log($(this).val() );
                if ($(this).val() == '') { 
                    $('.konten-tpu').hide(); 
                    $('.konten-kadis-uptd').hide(); 
                }
        
                if ($(this).val() == '1') { 
                $('.konten-tpu').hide(); 
                $('.konten-kadis-uptd').hide(); 
    
                }

                if ($(this).val() == '0') { 
                $('.konten-tpu').show(); 
                $('.konten-kadis-uptd').hide(); 

    
                }

                if ($(this).val() == '3') { 
                $('.konten-tpu').hide(); 
                $('.konten-kadis-uptd').show(); 

    
                }

                if ($(this).val() == '2') { 
                $('.konten-tpu').hide(); 
                $('.konten-kadis-uptd').show(); 

    
                }
            }
        );
</script>