                                        <td style="vertical-align: top;">Surat Ijin Perpanjangan Pemakaman Tumpang berlaku sejak <strong><%= data[0].tanggal_surat%></strong> s/d <strong><%= data[0].tanggal_berlaku_surat%></strong>.
                                        </td>
