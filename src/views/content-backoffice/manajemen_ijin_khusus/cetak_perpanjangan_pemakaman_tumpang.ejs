<body style="position: relative;">
    <button class="button" id="btn-print">Cetak</button>
    <page size="A4">
        <div class="width:100%">
            <img src="/images/template/kop_surat_disperkim_2026.jpg" alt="" style="width: 100%;">
        </div>

        <div style="width: 100%;">
            <h4 style="text-align: center;margin:2.5mm 0 0 0">KEPUTUSAN KEPALA DINAS PERUMAHAN DAN KAWASAN PERMUKIMAN</h4>
            <h4 style="text-align: center;">KOTA SEMARANG</h4>
            <h4 style="text-align: center;margin:2.5mm 0">NOMOR : <%=data[0].nomor_surat%></h4>
            <h4 style="text-align: center;margin:2.5mm 0">TENTANG</h4>
            <h4 style="text-align: center;margin:2.5mm 0 0 0"><strong>IJIN PERPANJANGAN PEMAKAMAN TUMPANG</strong></h4>
            <h4 style="text-align: center;">DI KOTA SEMARANG</h4>
            <h4 style="text-align: center;margin:2.5mm 0">KEPALA DINAS PERUMAHAN DAN KAWASAN PERMUKIMAN KOTA SEMARANG</h4>
        </div>

        <div style="width: 100%;margin-top: 5mm;">
            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%">
                <tbody>
                    <tr>
                        <td style="width: 50mm;vertical-align:top">Memperhatikan</td>
                        <td style="vertical-align: top;width: 5mm;">:</td>
                        <td>
                            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse;width:100%">
                                <tbody>
                                    <tr>
                                        <td style="width: 50mm;vertical-align: top;">Surat Permohonan</td>
                                        <td style="width: 5mm;vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].nama_ahli_waris%></td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">Tanggal</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].inserted_perpanjangan%></td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">Alamat</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="text-transform: capitalize;vertical-align: top;">
                                            <%= data[0].alamat_pemohon?data[0].alamat_pemohon:''%> <%if( data[0].domisili==0){%>Kelurahan <span style="color: #000 !important;"><%= data[0].kelurahan_pemohon?data[0].kelurahan_pemohon[0].toUpperCase()+data[0].kelurahan_pemohon.substring(1,data[0].kelurahan_pemohon.length).toLowerCase():''%></span> Kecamatan <span style="color: #000 !important;"><%=  data[0].kecamatan_pemohon?data[0].kecamatan_pemohon[0].toUpperCase()+data[0].kecamatan_pemohon.substring(1,data[0].kecamatan_pemohon.length).toLowerCase():''%>
                                            </span><%}%>  
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">Perihal</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="vertical-align: top;">Permohonan Perpanjangan Ijin Pemakaman Tumpang</td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div style="width: 100%;margin-top: 5mm;">
            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%">
                <tbody>
                    <tr>
                        <td style="width: 50mm;vertical-align:top">Menimbang</td>
                        <td style="vertical-align: top;width: 5mm;">:</td>
                        <td>
                            &nbsp;
                        </td>
                    </tr>

                    <tr>
                        <td style="width: 50mm;vertical-align:top">&nbsp;</td>
                        <td style="vertical-align: top;width: 5mm;">&nbsp;</td>
                        <td>
                            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse;width:100%">
                                <tbody>
                                    <tr>
                                        <td style="width: 10mm;vertical-align: top;">a.</td>
                                        <td style="vertical-align: top;text-align: justify;">bahwa permohonan ijin sebagaimana tersebut di atas telah memenuhi persyaratan dan ketentuan, maka Pemerintah Kota Semarang <strong>tidak keberatan menerbitkan dan memberikan Ijin Perpanjangan Pemakaman Tumpang</strong> dimaksud;
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">b.</td>
                                        <td style="vertical-align: top;text-align: justify;">bahwa untuk melaksanakan maksud tersebut di atas, perlu diterbitkan keputusan Kepala Dinas Perumahan dan Kawasan Permukiman Kota Semarang.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div style="width: 100%;margin-top: 5mm;">
            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%">
                <tbody>
                    <tr>
                        <td style="width: 50mm;vertical-align:top">Mengingat</td>
                        <td style="vertical-align: top;width: 5mm;">:</td>
                        <td>
                            &nbsp;
                        </td>
                    </tr>

                    <tr>
                        <td style="width: 50mm;vertical-align:top">&nbsp;</td>
                        <td style="vertical-align: top;width: 5mm;">&nbsp;</td>
                        <td>
                            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse;width:100%">
                                <tbody>
                                    <tr>
                                        <td style="width: 10mm;vertical-align: top;">1.</td>
                                        <td style="vertical-align: top;text-align:justify">
                                            Undang-undang Nomor 16 Tahun 1950 tentang Pembentukan Daerah – Daerah Kota Besar Dalam Lingkungan Provinsi Jawa Timur, Jawa Tengah, Jawa Barat dan Daerah Istimewa Yogyakarta (Himpunan Lembaran Negara Republik Indonesia Tahun 1950);
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">2.</td>
                                        <td style="vertical-align: top;text-align:justify">Undang-undang Nomor 34 Tahun 2000 tentang Perubahan atas Undang-undang Nomor 18 Tahun 1997 tentang Pajak Daerah dan Retribusi Daerah (Lembaran Negara RI Tahun 2000 Nomor 246);
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">3.</td>
                                        <td style="vertical-align: top;text-align:justify">Undang-undang Nomor 32 Tahun 2004 tentang Pemerintah Daerah (Lembaran Negara Republik Indonesia Nomor 4437) sebagaimana telah diubah dengan Undang-undang Nomor 8 Tahun 2005 tentang Penetapan Peraturan Pemerintah Pengganti Undang-undang Nomor 3 Tahun 2005 tentang Perubahan atas Undang-undang Nomor 32 Tahun 2004 Pemerintah Daerah menjadi Undang-undang (Lembaran Negara Republik Indonesia Tahun 2005 Nomor 108, Tambahan Lembaran Negara Republik Indonesia Nomor 4548);
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">4.</td>
                                        <td style="vertical-align: top;text-align:justify">Peraturan Pemerintah Nomor 16 Tahun 1976 tentang Perluasan Kotamadya Daerah Tingkat II Semarang (Lembaran Negara Republik Indonesia Tahun 1976 Nomor 3079);

                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">5.</td>
                                        <td style="vertical-align: top;text-align:justify">Peraturan Pemerintah Nomor 50 Tahun 1992 tentang Pembentukan Kecamatan di wilayah Kabupaten-kabupaten Daerah Tingkat II Purbalingga, Cilacap, Wonogiri dan Kendal serta penataan kecamatan di wilayah Kotamadya Daerah Tingkat II Semarang dalam wilayah Provinsi Daerah Tingkat I Jawa Tengah (Lembaran Negara Republik Indonesia Tahun 1992 Nomor 89);
                                        </td>
                                    </tr>   

                                    <tr>
                                        <td style="vertical-align: top;">6.</td>
                                        <td style="vertical-align: top;text-align:justify">Peraturan Daerah Kota Semarang Nomor 10 Tahun 2023 Tentang Pajak Daerah dan Retribusi Daerah;
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="vertical-align: top;">7.</td>
                                        <td style="vertical-align: top;">Peraturan Wali kota (Perwal) Semarang Nomor 44 Tahun 2025 tentang Organisasi dan Tata Kerja Unit Pelaksana Teknis Dinas (UPTD) Pemakaman pada Dinas Perumahan dan Kawasan Permukiman
                                        </td>
                                    </tr>
                                    <!-- <tr>
                                        <td style="vertical-align: top;">6.</td>
                                        <td style="vertical-align: top;text-align:justify">Peraturan Daerah Kota Semarang Nomor 10 Tahun 2009 tentang Penyelenggaraan dan Retribusi Pelayanan Pemakaman Jenazah di Kota Semarang;
                                        </td>
                                    </tr> -->

                                    <!-- <tr>
                                        <td style="vertical-align: top;">7.</td>
                                        <td style="vertical-align: top;text-align:justify">Peraturan Daerah Kota Semarang Nomor 2 Tahun 2012 tentang Retribusi Jasa Umum di Kota Semarang;
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">8.</td>
                                        <td style="vertical-align: top;text-align:justify">Peraturan Daerah Kota Semarang Nomor 14 Tahun 2016 tentang Pembentukan dan Satuan Perangkat Daerah Kota Semarang;
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">9.</td>
                                        <td style="vertical-align: top;text-align:justify">Keputusan Walikota Semarang Nomor 65 Tahun 2016 tentang Penjabaran Tugas dan Fungsi Dinas Perumahan dan Kawasan Permukiman Kota Semarang Berita Acara Nomor 65;
                                        </td>
                                    </tr> -->
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div style="width: 100%;margin-top:5mm; page-break-inside: avoid;">
            <h4 style="text-align: center;"><strong>MEMUTUSKAN :</strong></h4>
            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%">
                <tbody>
                    <tr>
                        <td style="width: 50mm;vertical-align:top">Menetapkan</td>
                        <td style="vertical-align: top;width: 5mm;">:</td>
                        <td>
                            &nbsp;
                        </td>
                    </tr>

                    <tr>
                        <td style="width: 50mm;vertical-align:top">PERTAMA</td>
                        <td style="vertical-align: top;width: 5mm;">:</td>
                        <td>
                            Memberikan Ijin Perpanjangan Pemakaman Tumpang  ke  <%=data[0].perpanjangan_ke%>, kepada :
                        </td>
                    </tr>

                    <tr>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>
                            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%">
                                <tbody>
                                    <tr>
                                        <td style="width: 40mm;vertical-align: top;">Nama</td>
                                        <td style="width: 2.5mm;vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].nama_ahli_waris%></td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">Pekerjaan</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].pekerjaan%></td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">Alamat</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="text-transform: capitalize;vertical-align: top;">
                                            <%= data[0].alamat_pemohon?data[0].alamat_pemohon:''%> <%if( data[0].domisili==0){%>Kelurahan <span style="color: #000 !important;"><%= data[0].kelurahan_pemohon?data[0].kelurahan_pemohon[0].toUpperCase()+data[0].kelurahan_pemohon.substring(1,data[0].kelurahan_pemohon.length).toLowerCase():''%></span> Kecamatan <span style="color: #000 !important;"><%=  data[0].kecamatan_pemohon?data[0].kecamatan_pemohon[0].toUpperCase()+data[0].kecamatan_pemohon.substring(1,data[0].kecamatan_pemohon.length).toLowerCase():''%>
                                            </span><%}%>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">No. Telepon / Hp</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].hp%></td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>
                            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%">
                                <tbody>
                                    <tr>
                                        <td colspan="3">Bagi jenazah almarhum/almarhumah :</td>
                                    </tr>
                                    <tr>
                                        <td style="width: 40mm;vertical-align: top;">Nama</td>
                                        <td style="width: 2.5mm;vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].nama_jenazah%></td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">Alamat Hidup</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="text-transform: capitalize;vertical-align: top;">
                                            <%= data[0].alamat_jenazah%> <%if( data[0].domisili_jenazah==0){%>Kelurahan <span style="color: #000 !important;"><%= data[0].kelurahan_jenazah?data[0].kelurahan_jenazah[0].toUpperCase()+data[0].kelurahan_jenazah.substring(1,data[0].kelurahan_jenazah.length).toLowerCase():'' %></span> Kecamatan <span style="color: #000 !important;"><%= data[0].kecamatan_jenazah? data[0].kecamatan_jenazah[0].toUpperCase()+data[0].kecamatan_jenazah.substring(1,data[0].kecamatan_jenazah.length).toLowerCase():''%></span><%}%>
                                        </td>
                                    </tr>

                                    <tr>
                                        <%if(data2.length>0){%>
                                        <td colspan="3">Yang ditumpangkan pada makam jenazah almarhun / mah <%=data2[data2.length-1].nama_jenazah%></td>
                                        <%}%>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">Lokasi Makam</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].alamat_makam%> <%=  data[0].keterangan_pengelola?' nomor liang tpu '+ data[0].keterangan_pengelola:''%></td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">Tanggal Meninggal</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].tanggal_meninggal%></td>
                                    </tr>
                                    
                                    <!-- <tr>
                                        <td style="vertical-align: top;">Lokasi Makam</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].alamat_makam%> <%=  data[0].keterangan_pengelola?' nomor liang tpu '+ data[0].keterangan_pengelola:''%></td>
                                    </tr>

                                    <tr>
                                        <td style="vertical-align: top;">Tanggal Meninggal</td>
                                        <td style="vertical-align: top;">:</td>
                                        <td style="vertical-align: top;"><%= data[0].tanggal_meninggal%></td>
                                    </tr> -->
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div style="width: 100%;margin-top: 5mm;">
            <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%">
                <tbody>

                    <tr>
                        <td style="width: 50mm;vertical-align:top">KEDUA</td>
