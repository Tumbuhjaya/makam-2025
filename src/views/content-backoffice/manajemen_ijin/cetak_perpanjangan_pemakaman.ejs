                    <div class="w-100" style="margin-top: 5mm;">
                        <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%">
                            <tbody>

                                <tr>
                                    <td style="width: 50mm;vertical-align:top">KEDUA</td>
                                    <td style="vertical-align: top;width: 5mm;">:</td>
                                    <td>
                                        Pemegang ijin dimaksud diktum PERTAMA harus memenuhi ketentuan sebagai berikut :
                                    </td>
                                </tr>

                                <tr>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                    <td>
                                        <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%">
                                            <tbody>
                                                <tr>
                                                    <td style="width: 10mm;vertical-align: top;">1.</td>
                                                    <td style="vertical-align: top;">Pemegang Ijin Perpanjangan Penggunaan Tanah Makam / Pemakaman Jenazah wajib mentaati semua ketentuan yang berlaku dan semua instruksi/petunjuk yang berwenang.</td>
                                                </tr>

                                                <tr>
                                                    <td style="vertical-align: top;">2.</td>
                                                    <td style="vertical-align: top;">Merawat kuburnya agar selalu tampak bersih dan teratur.</td>
                                                </tr>

                                                <!-- <tr>
                                                    <td style="vertical-align: top;">3.</td>
                                                    <td style="vertical-align: top;">Setiap petak makam tidak diijinkan didirikan bangunan dengan bentuk apapun kecuali tanda nisan atau batu nisan berbentuk trapesium.</td>
                                                </tr> -->

                                                <!-- <tr>
                                                    <td style="vertical-align: top;">4.</td>
                                                    <td style="vertical-align: top;">Pemindahan, dan atau pembongkaran/tumpang kerangka jenazah dapat dilakukan apabila telah dimakamkan paling singkat 3 (tiga) tahun.</strong>.
                                                    </td>
                                                </tr> -->

                                                <tr>
                                                    <td style="vertical-align: top;">3.</td>
                                                    <td style="vertical-align: top;">Surat Ijin Perpanjangan Penggunaan Tanah Makam / Pemakaman Jenazah berlaku selama 3 (tiga) tahun dengan kewajiban melakukan perpanjangan setiap 3 (tiga) tahun diperpanjang.
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="vertical-align: top;">4.</td>
                                                    <!-- <td style="vertical-align: top;">Surat Ijin Perpanjangan Penggunaan Tanah Makam berlaku sejak<i>Masa_berlaku_Awal</i> s/d <i>Masa_berlaku_Akhi</i>. -->
                                                    <td style="vertical-align: top;">Surat Ijin Perpanjangan Penggunaan Tanah Makam / Pemakaman Jenazah berlaku sejak <strong><%= data[0].tanggal_surat%></strong> s/d <strong><%= data[0].tanggal_berlaku_surat%></strong>.
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="vertical-align: top;">5.</td>
                                                    <td style="vertical-align: top;">Apabila dalam jangka waktu 2 (dua) kali masa daftar ulang penggunaan tanah makam tidak dilakukan perpanjangan  maka petak makam dapat digunakan untuk pemakaman jenazah orang lain dan/atau dilakukan pembongkaran.
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="vertical-align: top;">6.</td>
                                                    <td style="vertical-align: top;">Jangka waktu 3 (tiga) tahun sebagaimana tersebut di atas sewaktu-waktu dapat ditinjau kembali apabila Pemerintah Kota Semarang menghendaki adanya penataan wilayah atau tuntutan keadaan.
                                                    </td>
                                                </tr>
                                                <!-- <tr>
                                                    <td style="vertical-align: top;">7.</td>
                                                    <td style="vertical-align: top;">Peraturan Walikota Kota Semarang Nomor 44 Tahun 2025 tentang Organisasi dan Tata Kerja Unit Pelaksana Teknis Dinas Pemakaman pada Dinas Perumahan dan Kawasan Permukiman
                                                    </td>
                                                </tr> -->
