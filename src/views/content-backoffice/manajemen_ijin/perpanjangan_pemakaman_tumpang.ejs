<!-- BEGIN PAGE CONTENT -->
<div class="page-content">
  <div class="header">
    <h2><strong>Data Perpanjangan Ijin Pemakaman Tumpang</strong></h2>
    <div class="breadcrumb-wrapper">
      <ol class="breadcrumb">
        <li><a href="/backoffice">Dashboard</a>
        </li>
        <li class="active">Data</li>
      </ol>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <div class="panel">
        <div class="panel-header header-line">
          <div class="alert alert-success" role="alert">
            <h5><strong>Filter data :</strong></h5>
            <hr>
            <div class="form-horizontal">
              <div class="form-group">
                <label for="" class="col-sm-3 control-label">Tanggal Permohonan</label>
                <div class="col-sm-4">
                  <input type="text"  class="form-control" id="mulai" placeholder="Tanggal Awal">
                </div>
                <div class="col-sm-5">
                  <input type="text"  class="form-control" id="akhir" placeholder="Tanggal Akhir">
                </div>
              </div>

              <div class="form-group">
                <label for="" class="col-sm-3 control-label">Keyword</label>
                <div class="col-sm-9">
                  <input type="text"  class="form-control" id="cari" placeholder="Nama Ahli Waris / Nama Jenazah / Nama TPU">
                </div>
              </div>

              <div class="form-group">
                <div class="col-sm-offset-3 col-sm-9">
                  <button type="submit" class="btn btn-dark btn-embossed" onclick="ubah_page(1)">Filter</button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="panel-content ">
          <div class="row">
            <div class="col-md-2 col-lg-2">
              <select name="" id="jumlah_data_per_page" class="form-control" style="width: 60%;">
                <option value="10">10</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>

          </div>
          <div class="row">
            <div class="col-md-12 col-lg-12">
              <div style="width: 100%;">
                <table class="table table-bordered table-striped table-hover" style="margin-bottom: 0;">
                  <thead>
                    <tr>
                      <th class="header" rowspan="2">No.</th>
                      <th class="header" rowspan="2">Tanggal Permohonan</th>
                      <!-- <th class="header" rowspan="2" style="min-width: 100px;">Kode Registrasi</th> -->
                      <th class="header" rowspan="2" style="min-width: 150px;">Nama Pemohon/Ahli Waris</th>
                      <th class="header" rowspan="2" style="min-width: 150px;">Nama Jenazah</th>
                      <th class="header" colspan="2" style="text-align: center;">Tanggal</th>
                      <!-- <th class="header" rowspan="2" style="text-align: center;">Tanggal Dimakamkan</th> -->
                      <th class="header" colspan="5" style="text-align: center;">Lokasi Pemakaman</th>
                      <th class="header" colspan="2" style="text-align: center;">Retribusi & Pembayaran</th>
                      <th class="header" rowspan="2" style="min-width: 100px;">Masa Berlaku Perijinan Sampai Dengan</th>
      
                      <th class="header" rowspan="2" style="min-width: 640px;">Option</th>
                    </tr>
      
                    <tr>
                      <th class="header" style="min-width: 120px;">Meninggal</th>
                      <th class="header" style="min-width: 120px;">Dimakamkan</th>
                      <th class="header" style="min-width: 100px;">Kecamatan</th>
                      <th class="header" style="min-width: 50px;">Lokasi</th>
                      <th class="header" style="min-width: 50px;">Blok</th>
                      <th class="header" style="min-width: 50px;">Sub Blok</th>
                      <th class="header" style="min-width: 50px;">No. Liang</th>
                      <th class="header" style="min-width: 100px;">Kode Billing</th>
                      <th class="header" style="min-width: 100px;">Status</th>
                    </tr>
                  </thead>
                  
                  <tbody>
                  
                  <tbody id="list_data">
                  </tbody>
                </table>
              </div>
            </div>

            
          </div>

          <div class="row">
            <div class="col-md-6 col-lg-6" style="background-color: ;">
              <div id="entry"></div>
            </div>

            <div class="col-md-6 col-lg-6 pagination2" style="background-color: ;">
              <nav aria-label="Page navigation example">
                <ul class="pagination">
                </ul>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>  
  </div>
  <% include ../../template-backoffice/copyright.ejs %>
</div>

<!-- END PAGE CONTENT -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Upload SK yang sudah ditandatangani</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form action="/manajemen_perijinan/uploadSKPerpanjangan" method="post" enctype="multipart/form-data">
          <div class="form-group">
            <label>Upload SK</label>
            <input type="file" class="form-control" name="sk_perpanjangan" id=""  accept="image/*,.pdf">
            <input type="text" name="id" id="perpanjangan_id" hidden>
            <input type="text" class="" name="jns_permohonan" id="" value="4" hidden>

          </div>
          <button type="submit" class="btn btn-primary">Upload</button>
        </form>
      </div>
      <!-- <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary">Save changes</button>
      </div> -->
    </div>
  </div>
</div>

<div class="modal fade modal-cetak-sk" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form action="/manajemen_perijinan/inputDataSKPerpanjangan" method="post"   enctype="application/x-www-form-urlencoded" class="form-horizontal">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title" id="myModalLabel">Buat Draft SK Perpanjangan Ijin Pemakaman Tumpang</h4>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label for="" class="col-sm-3 control-label">No. Surat</label>
            <div class="col-sm-9">
              <input type="text" class="form-control" name="nomor_surat" id="nomor_surat" value="">
            </div>
          </div>
          <input type="text" class="perpanjangan_id" name="id" id="" hidden>
          <input type="text" class="jenazah_id" name="jenazah_id" id="" hidden>
          <input type="text" class="" name="jns_permohonan" id="" value="4" hidden>
            <input type="text" name="juuid" class="juuid" hidden>

          <div class="form-group">
            <label for="" class="col-sm-3 control-label">Tanggal Penetapan</label>
            <div class="col-sm-9">
              <input type="text" class="form-control" name="tanggal_surat" id="tgl3" value="" >
            </div>
          </div>

          <div class="form-group">
            <label for="" class="col-sm-3 control-label">Penandatangan</label>
            <div class="col-sm-9" id="penandatangan_id">
              <select name="" id="" class="form-control">
                <option value="">-- Pilih --</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <!-- <button type="button" class="btn btn-default" data-dismiss="modal">Close</button> -->
          <button type="submit" class="btn btn-primary">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>

