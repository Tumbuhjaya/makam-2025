        // sudut = derajat searah jarum jam dari utara, sisi panjang (2 m) mengikuti sudut
        function kotakLiang(center, sudut) {
            var rad = sudut * Math.PI / 180
            var mLat = 111320
            var mLng = 111320 * Math.cos(center.lat * Math.PI / 180)
            var w = LIANG_LEBAR / 2, h = LIANG_PANJANG / 2
            return [[-w, -h], [w, -h], [w, h], [-w, h]].map(function (p) {
                var x = p[0] * Math.cos(rad) + p[1] * Math.sin(rad)
                var y = -p[0] * Math.sin(rad) + p[1] * Math.cos(rad)
                return L.latLng(center.lat + y / mLat, center.lng + x / mLng)
            })
        }

        function gambarLiang() {
            if (!liang.center) return
            var titik = kotakLiang(liang.center, liang.sudut)
            if (liang.layer) {
                liang.layer.setLatLngs(titik)
            } else {
                liang.layer = L.polygon(titik, { color: '#bada55', className: 'liang-geser' })
                liang.layer.on('mousedown touchstart', mulaiGeserLiang)
                drawnItems.addLayer(liang.layer)
            }
            if (!liang.marker) {
                liang.marker = L.marker(liang.center, { draggable: true, title: 'Geser liang' }).addTo(map)
                liang.marker.on('drag', function (e) {
                    liang.center = e.target.getLatLng()
                    gambarLiang()
                })
            }
            $('#SHAPE').val(toWKT(liang.layer))
            $('#liang_sudut, #liang_sudut_range').val(liang.sudut)
        }

        // geser liang dengan menarik shape-nya langsung
        var sedangMenggambar = false
        map.on('draw:drawstart draw:editstart draw:deletestart', function () { sedangMenggambar = true })
        map.on('draw:drawstop draw:editstop draw:deletestop', function () { sedangMenggambar = false })

        function mulaiGeserLiang(e) {
            if (sedangMenggambar || !liang.center) return
            L.DomEvent.stop(e)
            var awal = e.latlng, pusatAwal = liang.center
            var mapBisaDigeser = map.dragging.enabled()
            map.dragging.disable()

            function geser(ev) {
                var t = ev.touches && ev.touches.length ? ev.touches[0] : ev
                var posisi = map.mouseEventToLatLng(t)
                liang.center = L.latLng(pusatAwal.lat + posisi.lat - awal.lat, pusatAwal.lng + posisi.lng - awal.lng)
                liang.marker.setLatLng(liang.center)
                gambarLiang()
                L.DomEvent.preventDefault(ev)
            }
            function selesai() {
                L.DomEvent.off(document, 'mousemove touchmove', geser)
                L.DomEvent.off(document, 'mouseup touchend', selesai)
                if (mapBisaDigeser) map.dragging.enable()
            }
            L.DomEvent.on(document, 'mousemove touchmove', geser)
            L.DomEvent.on(document, 'mouseup touchend', selesai)
        }

        function hapusLiang() {
            if (liang.marker) map.removeLayer(liang.marker)
            liang = { center: null, sudut: liang.sudut, layer: null, marker: null }
