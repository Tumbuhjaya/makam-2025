<style>
/* liang bisa digeser dengan ditarik */
path.liang-geser.leaflet-interactive {
  cursor: move;
}

/* Style untuk tab */
.tab {
  overflow: hidden;
  border: 1px solid #ccc;
  background-color: #f1f1f1;
}

/* Style tombol di dalam tab */
.tab button {
  background-color: inherit;
  float: left;
  border: none;
  outline: none;
  cursor: pointer;
  padding: 14px 16px;
  transition: 0.3s;
  font-size: 17px;
}

/* Ubah warna latar belakang tombol saat di-hover */
.tab button:hover {
  background-color: #ddd;
}

/* Buat tombol aktif terlihat berbeda */
.tab button.active {
  background-color: #ccc;
}

/* Style konten tab */
.tabcontent {
  display: none;
  padding: 6px 12px;
  border: 1px solid #ccc;
  border-top: none;
}
</style>
