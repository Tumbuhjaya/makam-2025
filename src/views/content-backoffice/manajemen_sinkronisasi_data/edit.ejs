    $('#jenis_pemakaman').change(function(){
        if ($(this).val() == '') {
            $('#konten-pemakaman-jenazah').hide();
            $('#konten-pemakaman-tumpang').hide();
        }

        if ($(this).val() == '1') {
            $('#konten-pemakaman-jenazah').show();
            $('#konten-pemakaman-tumpang').hide();
        } 

        if ($(this).val() == '2') {
            $('#konten-pemakaman-jenazah').hide();
            $('#konten-pemakaman-tumpang').show();
        }    
    });

    function openTab(evt, tabName) {
  // Deklarasikan variabel
  var i, tabcontent, tablinks;

  // Dapatkan semua elemen dengan class="tabcontent" dan sembunyikan
  tabcontent = document.getElementsByClassName("tabcontent");
  for (i = 0; i < tabcontent.length; i++) {
    tabcontent[i].style.display = "none";
  }

  // Dapatkan semua elemen dengan class="tablinks" dan hapus class "active"
  tablinks = document.getElementsByClassName("tablinks");
  for (i = 0; i < tablinks.length; i++) {
    tablinks[i].className = tablinks[i].className.replace(" active", "");
  }

  // Tampilkan tab saat ini, dan tambahkan class "active" ke tombol yang membuka tab
  document.getElementById(tabName).style.display = "block";
  evt.currentTarget.className += " active";
}

